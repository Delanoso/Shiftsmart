# Server port
PORT=3001

# Baseline defaults used when no historical data exists yet
DRIVER_BASELINE_START_MS=550
COMPANY_BASELINE_START_MS=550

# Fatigue flagging thresholds
# If session median is slower than (driver baseline + margin) => flag
ALERT_MARGIN_MS=150
# If session median is slower than (company baseline * factor) => flag
ALERT_COMPANY_FACTOR=1.35
# Individual click threshold (ms): clicks >= this contribute to alerting
POOR_REACTION_MS=800

# Alerts
# Recommended: provide a webhook URL to receive fatigue alert payloads.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3500

# Optional (not wired yet): placeholder for SMS/call integration.
ALERT_PHONE_NUMBER=

