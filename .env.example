# Copy to `.env` for local or production runs
# Buyer IT: see deploy/customer/IT-SETUP.md

PORT=3001

# --- Company identity (overrides data/company.json when set) ---
COMPANY_ID=company-1
COMPANY_NAME=Your Company Name
VENDOR_NAME=
PRODUCT_NAME=ShiftSmart Fatigue Check
BRAND_PRIMARY=#0c2340
BRAND_ACCENT=#3b82f6
BRAND_TARGET=#ef4444
LOGO_PATH=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# DISCLAIMER=

# Baselines when no history yet (ms)
EMPLOYEE_BASELINE_START_MS=550
COMPANY_BASELINE_START_MS=550

# Green / red thresholds
ALERT_MARGIN_MS=150
ALERT_COMPANY_FACTOR=1.35
POOR_REACTION_MS=800

# Optional webhook for red sessions
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3500

# Admin dashboard — change from default before production
ADMIN_API_KEY=ADMIN-API-KEY

# Kiosk / depot tablet
KIOSK_MODE=false
KIOSK_RESULTS_SECONDS=12
KIOSK_EXIT_PIN=
KIOSK_REQUIRE_EXIT_PIN=true
