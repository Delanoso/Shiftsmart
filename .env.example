# Server port
PORT=3001

# --- White-label / customer identity (Option 2 installs) ---
# Overrides data/company.json when set
COMPANY_ID=company-1
COMPANY_NAME=Demo Transport Co.
VENDOR_NAME=Delano Solutions
PRODUCT_NAME=ShiftSmart Fatigue Check
BRAND_PRIMARY=#0c2340
BRAND_ACCENT=#3b82f6
BRAND_TARGET=#ef4444
LOGO_PATH=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# DISCLAIMER=

# Baseline defaults used when no historical data exists yet
EMPLOYEE_BASELINE_START_MS=550
COMPANY_BASELINE_START_MS=550

# Fatigue flagging thresholds
# If session median is slower than (employee baseline + margin) => flag
ALERT_MARGIN_MS=150
# If session median is slower than (company baseline * factor) => flag
ALERT_COMPANY_FACTOR=1.35
# Individual click threshold (ms): clicks >= this contribute to alerting
POOR_REACTION_MS=800

# Alerts
# Recommended: provide a webhook URL to receive fatigue alert payloads.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3500

# Optional (not wired yet): placeholder for SMS/call integration.
ALERT_PHONE_NUMBER=

# --- Admin dashboard (supervisor notifications + session export) ---
ADMIN_API_KEY=change-me-to-a-long-random-secret

# --- Kiosk / depot tablet mode ---
KIOSK_MODE=false
KIOSK_RESULTS_SECONDS=12
KIOSK_EXIT_PIN=
KIOSK_REQUIRE_EXIT_PIN=true

