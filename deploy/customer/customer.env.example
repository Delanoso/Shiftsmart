# Customer install — copy to `.env` in the project root

PORT=3001

# --- Client identity (white-label) ---
COMPANY_ID=company-1
COMPANY_NAME=Your Company Name Here
VENDOR_NAME=Delano Solutions
PRODUCT_NAME=ShiftSmart Fatigue Check

# Brand colours (hex)
BRAND_PRIMARY=#0c2340
BRAND_ACCENT=#3b82f6
BRAND_TARGET=#ef4444

# Optional: path under public/ e.g. client-logo.png → served as /client-logo.png
LOGO_PATH=

SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=

# Short disclaimer shown on login (or set in data/company.json)
# DISCLAIMER=

# --- Baselines ---
DRIVER_BASELINE_START_MS=550
COMPANY_BASELINE_START_MS=550

# --- Fatigue thresholds ---
ALERT_MARGIN_MS=150
ALERT_COMPANY_FACTOR=1.35
POOR_REACTION_MS=800

# --- Alerts (recommended for production) ---
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3500
ALERT_PHONE_NUMBER=
