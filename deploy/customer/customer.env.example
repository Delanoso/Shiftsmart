# Customer install — copy to `.env` in the project root
# Full steps: deploy/customer/IT-SETUP.md

PORT=3001

# --- Company identity ---
COMPANY_ID=company-1
COMPANY_NAME=Your Company Name Here
VENDOR_NAME=
PRODUCT_NAME=ShiftSmart Fatigue Check

# Brand colours (hex) — supervisors can also change these in Admin → Settings
BRAND_PRIMARY=#0c2340
BRAND_ACCENT=#3b82f6
BRAND_TARGET=#ef4444

# Optional: file under public/, e.g. client-logo.png
LOGO_PATH=

SUPPORT_EMAIL=
SUPPORT_PHONE=

# DISCLAIMER=

# --- Baselines (ms) when no history yet ---
EMPLOYEE_BASELINE_START_MS=550
COMPANY_BASELINE_START_MS=550

# --- Green / red thresholds ---
ALERT_MARGIN_MS=150
ALERT_COMPANY_FACTOR=1.35
POOR_REACTION_MS=800

# --- Optional webhook for red sessions ---
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3500

# --- Admin (/admin) — change before go-live ---
ADMIN_API_KEY=ADMIN-API-KEY

# --- Kiosk / depot tablet ---
KIOSK_MODE=true
KIOSK_RESULTS_SECONDS=12
KIOSK_EXIT_PIN=
KIOSK_REQUIRE_EXIT_PIN=true
